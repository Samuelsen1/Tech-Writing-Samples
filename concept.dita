<concept id="intro" class="- topic/topic concept/concept ">
  <title class="- topic/title ">Introduction to Welth</title>
  <shortdesc class="- topic/shortdesc ">Welth is a user-friendly platform designed to help users manage health conditions using information from the World Health Organization (WHO).</shortdesc>
  <conbody class="- topic/body concept/conbody ">
    <section class="- topic/section ">
      <title class="- topic/title ">Key Features:</title>
      <ul class="- topic/ul ">
        <li class="- topic/li ">Track symptoms</li>
        <li class="- topic/li ">Monitor medication intake</li>
        <li class="- topic/li ">Book nearby medical appointments</li>
        <li class="- topic/li ">Order prescribed medications</li>
        <li class="- topic/li ">Manage ongoing health conditions</li>
      </ul>
    </section>
  </conbody>
</concept>
